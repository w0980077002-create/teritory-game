{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "territory-sdolars",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ALLOW_GUESTS": "true"
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_HUB", "class_name": "GameHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameHub"] }
  ]
}
